<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Hourly Price Distribution Analyzer</title>

<style>

/* ============================================================
   DESIGN SYSTEM
   ============================================================ */

:root {

    --navy: #071b2b;
    --navy-2: #0b2638;
    --navy-3: #103348;

    --green: #b7d63b;
    --green-dark: #8ea923;

    --cream: #f4f3ed;
    --white: #ffffff;

    --muted: #9caeb8;

    --border: #294453;
    --border-light: #3b5868;

    --blue: #6fc4d8;
    --red: #e17b73;

}


/* ============================================================
   GLOBAL RESET
   ============================================================ */

*,
*::before,
*::after {

    box-sizing: border-box;

    /*
        No rounded UI anywhere.
    */

    border-radius: 0 !important;

}


html {

    scroll-behavior: smooth;

}


body {

    margin: 0;

    background: var(--navy);

    color: var(--cream);

    font-family:
        Inter,
        Arial,
        Helvetica,
        sans-serif;

    line-height: 1.5;

}


button,
input,
select {

    font: inherit;

}


/* ============================================================
   HEADER
   ============================================================ */

header {

    background: var(--navy);

    border-bottom:
        1px solid
        var(--border);

}


.header-inner {

    max-width: 1440px;

    margin: 0 auto;

    padding:
        25px
        42px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

}


.brand {

    display: flex;

    align-items: center;

    gap: 15px;

}


.brand-mark {

    width: 38px;

    height: 38px;

    background: var(--green);

    color: var(--navy);

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 13px;

    font-weight: 900;

}


.brand-title {

    color: var(--white);

    font-size: 17px;

    font-weight: 750;

    letter-spacing: -0.02em;

}


.brand-subtitle {

    color: var(--muted);

    font-size: 11px;

    margin-top: 2px;

}


/* ============================================================
   MAIN
   ============================================================ */

main {

    max-width: 1440px;

    margin: 0 auto;

    padding:
        70px
        42px
        100px;

}


.hero {

    max-width: 900px;

    margin-bottom: 70px;

}


.eyebrow {

    color: var(--green);

    font-size: 11px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 0.16em;

    margin-bottom: 20px;

}


h1 {

    margin: 0;

    color: var(--cream);

    font-size:
        clamp(
            42px,
            5.5vw,
            76px
        );

    line-height: 0.98;

    letter-spacing: -0.055em;

    font-weight: 700;

}


.hero p {

    max-width: 720px;

    margin-top: 27px;

    color: var(--muted);

    font-size: 17px;

    line-height: 1.7;

}


/* ============================================================
   SECTIONS
   ============================================================ */

.section {

    margin-top: 60px;

    border-top:
        1px solid
        var(--border);

    padding-top: 30px;

}


.section-heading {

    display: flex;

    align-items: baseline;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;

}


.section-heading h2 {

    margin: 0;

    font-size: 18px;

    font-weight: 700;

    letter-spacing: -0.02em;

}


.section-heading span {

    color: var(--muted);

    font-size: 11px;

    text-transform: uppercase;

    letter-spacing: 0.08em;

}


/* ============================================================
   UPLOAD
   ============================================================ */

.upload-area {

    border:
        1px dashed
        var(--border-light);

    background:
        linear-gradient(
            135deg,
            var(--navy-2),
            var(--navy)
        );

    padding: 40px;

    cursor: pointer;

    transition:
        border-color 0.15s ease,
        background 0.15s ease;

}


.upload-area:hover,
.upload-area.dragover {

    border-color: var(--green);

    background: var(--navy-3);

}


.upload-title {

    font-size: 20px;

    font-weight: 700;

}


.upload-description {

    max-width: 650px;

    margin:
        7px
        0
        24px;

    color: var(--muted);

    font-size: 13px;

}


.upload-controls {

    display: flex;

    gap: 10px;

    align-items: center;

}


/* ============================================================
   BUTTONS
   ============================================================ */

button {

    border:
        1px solid
        var(--border-light);

    background: transparent;

    color: var(--cream);

    padding:
        11px
        17px;

    cursor: pointer;

    font-size: 12px;

    font-weight: 750;

    text-transform: uppercase;

    letter-spacing: 0.05em;

    transition:
        background 0.15s ease,
        color 0.15s ease,
        border-color 0.15s ease;

}


button:hover {

    border-color: var(--green);

    color: var(--green);

}


button.primary {

    background: var(--green);

    border-color: var(--green);

    color: var(--navy);

}


button.primary:hover {

    background: var(--green-dark);

    border-color: var(--green-dark);

    color: var(--navy);

}


button:disabled {

    opacity: 0.4;

    cursor: not-allowed;

}


/* ============================================================
   FILE STATUS
   ============================================================ */

.file-status {

    display: none;

    margin-top: 22px;

    padding-top: 18px;

    border-top:
        1px solid
        var(--border);

    color: var(--muted);

    font-size: 12px;

}


.file-status.visible {

    display: block;

}


.file-status strong {

    color: var(--green);

}


/* ============================================================
   CONTROLS
   ============================================================ */

.controls {

    display: grid;

    grid-template-columns:
        repeat(
            4,
            minmax(0, 1fr)
        );

    border:
        1px solid
        var(--border);

    background: var(--navy-2);

}


.control {

    padding: 20px;

    border-right:
        1px solid
        var(--border);

}


.control:last-child {

    border-right: 0;

}


label {

    display: block;

    color: var(--muted);

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 0.1em;

    font-weight: 800;

    margin-bottom: 9px;

}


input[type="date"],
select {

    width: 100%;

    background: var(--navy);

    color: var(--cream);

    border:
        1px solid
        var(--border-light);

    padding:
        11px
        12px;

    outline: none;

}


input[type="date"]:focus,
select:focus {

    border-color: var(--green);

}


/* ============================================================
   METRICS
   ============================================================ */

.metrics {

    display: grid;

    grid-template-columns:
        repeat(
            4,
            1fr
        );

    border:
        1px solid
        var(--border);

    background: var(--navy-2);

}


.metric {

    padding: 27px;

    border-right:
        1px solid
        var(--border);

}


.metric:last-child {

    border-right: 0;

}


.metric-label {

    color: var(--muted);

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 0.1em;

    font-weight: 800;

}


.metric-value {

    margin-top: 8px;

    color: var(--cream);

    font-size: 30px;

    font-weight: 700;

    letter-spacing: -0.04em;

}


/* ============================================================
   CHART
   ============================================================ */

.chart-panel {

    border:
        1px solid
        var(--border);

    background: var(--navy-2);

    padding: 25px;

}


.chart-toolbar {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    margin-bottom: 20px;

}


.legend {

    display: flex;

    flex-wrap: wrap;

    gap: 20px;

    color: var(--muted);

    font-size: 11px;

}


.legend-item {

    display: flex;

    align-items: center;

    gap: 7px;

}


.legend-line {

    width: 24px;

    height: 2px;

}


.legend-p10 {

    background: var(--red);

}


.legend-p50 {

    background: var(--green);

}


.legend-p90 {

    background: var(--blue);

}


.legend-mean {

    background: var(--cream);

}


canvas {

    width: 100%;

    height: 520px;

    display: block;

}


/* ============================================================
   TABLE
   ============================================================ */

.table-wrapper {

    overflow-x: auto;

    border:
        1px solid
        var(--border);

    background: var(--navy-2);

}


table {

    width: 100%;

    border-collapse: collapse;

    min-width: 760px;

}


th {

    text-align: right;

    color: var(--muted);

    background: var(--navy);

    border-bottom:
        1px solid
        var(--border);

    padding:
        14px
        16px;

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 0.08em;

    font-weight: 800;

}


th:first-child,
td:first-child {

    text-align: left;

}


td {

    padding:
        13px
        16px;

    border-bottom:
        1px solid
        rgba(
            54,
            83,
            98,
            0.45
        );

    text-align: right;

    font-size: 13px;

    font-variant-numeric:
        tabular-nums;

}


tbody tr:hover {

    background: var(--navy-3);

}


tbody tr:last-child td {

    border-bottom: 0;

}


/* ============================================================
   LOGIC
   ============================================================ */

.logic-grid {

    display: grid;

    grid-template-columns:
        repeat(
            3,
            1fr
        );

    border:
        1px solid
        var(--border);

    background: var(--navy-2);

}


.logic-item {

    padding: 28px;

    border-right:
        1px solid
        var(--border);

}


.logic-item:last-child {

    border-right: 0;

}


.logic-number {

    color: var(--green);

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 0.08em;

    margin-bottom: 10px;

}


.logic-item h3 {

    margin:
        0
        0
        9px;

    font-size: 17px;

}


.logic-item p {

    margin: 0;

    color: var(--muted);

    font-size: 13px;

    line-height: 1.7;

}


/* ============================================================
   FOOTER
   ============================================================ */

footer {

    border-top:
        1px solid
        var(--border);

    padding:
        25px
        42px;

    color: var(--muted);

    font-size: 11px;

}


.footer-inner {

    max-width: 1440px;

    margin: 0 auto;

    display: flex;

    justify-content: space-between;

    gap: 20px;

}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 900px) {

    main {

        padding:
            50px
            25px
            80px;

    }


    .controls {

        grid-template-columns:
            repeat(
                2,
                1fr
            );

    }


    .control:nth-child(2) {

        border-right: 0;

    }


    .metrics {

        grid-template-columns:
            repeat(
                2,
                1fr
            );

    }


    .metric:nth-child(2) {

        border-right: 0;

    }


    .logic-grid {

        grid-template-columns: 1fr;

    }


    .logic-item {

        border-right: 0;

        border-bottom:
            1px solid
            var(--border);

    }


    .logic-item:last-child {

        border-bottom: 0;

    }

}


@media (max-width: 600px) {

    .header-inner,
    main {

        padding-left: 18px;

        padding-right: 18px;

    }


    .controls,
    .metrics {

        grid-template-columns: 1fr;

    }


    .control,
    .metric {

        border-right: 0;

        border-bottom:
            1px solid
            var(--border);

    }


    .control:last-child,
    .metric:last-child {

        border-bottom: 0;

    }


    .upload-area {

        padding: 25px;

    }


    canvas {

        height: 400px;

    }


    footer {

        padding:
            25px
            18px;

    }


    .footer-inner {

        flex-direction: column;

    }

}

</style>
</head>


