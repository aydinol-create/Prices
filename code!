    document.getElementById(
        "exportBtn"
    );

const demoBtn =
    document.getElementById(
        "demoBtn"
    );

const canvas =
    document.getElementById(
        "chart"
    );

const ctx =
    canvas.getContext(
        "2d"
    );


/* ============================================================
   CSV PARSER
   ============================================================ */

function parseCSV(text) {

    const rows = [];

    let row = [];

    let cell = "";

    let insideQuotes = false;


    for (
        let i = 0;
        i < text.length;
        i++
    ) {

        const char =
            text[i];

        const next =
            text[i + 1];


        if (
            char === '"' &&
            insideQuotes &&
            next === '"'
        ) {

            cell += '"';

            i++;

            continue;

        }


        if (char === '"') {

            insideQuotes =
                !insideQuotes;

            continue;

        }


        if (
            char === "," &&
            !insideQuotes
        ) {

            row.push(cell);

            cell = "";

            continue;

        }


        if (
            (
                char === "\n" ||
                char === "\r"
            ) &&
            !insideQuotes
        ) {

            if (
                char === "\r" &&
                next === "\n"
            ) {

                i++;

            }


            row.push(cell);

            cell = "";


            if (
                row.some(
                    value =>
                        value.trim() !== ""
                )
            ) {

                rows.push(row);

            }


            row = [];

            continue;

        }


        cell += char;

    }


    if (
        cell.length > 0 ||
        row.length > 0
    ) {

        row.push(cell);


        if (
            row.some(
                value =>
                    value.trim() !== ""
            )
        ) {

            rows.push(row);

        }

    }


    if (rows.length === 0) {

        return [];

    }


    const headerRow =
        rows[0].map(
            value =>
                value.trim()
        );


    return rows
        .slice(1)
        .map(row => {

            const object = {};


            headerRow.forEach(
                (header, index) => {

                    object[header] =
                        row[index] ?? "";

                }
            );


            return object;

        });

}


/* ============================================================
   FILE HANDLING
   ============================================================ */

fileButton.addEventListener(
    "click",
    event => {

        event.stopPropagation();

        fileInput.click();

    }
);


fileInput.addEventListener(
    "change",
    () => {

        if (
            fileInput.files.length > 0
        ) {

            processFile(
                fileInput.files[0]
            );

        }

    }
);


dropZone.addEventListener(
    "click",
    event => {

        if (
            event.target !== fileButton &&
            !event.target.closest("button")
        ) {

            fileInput.click();

        }

    }
);


dropZone.addEventListener(
    "dragover",
    event => {

        event.preventDefault();

        dropZone.classList.add(
            "dragover"
        );

    }
);


dropZone.addEventListener(
    "dragleave",
    () => {

        dropZone.classList.remove(
            "dragover"
        );

    }
);


dropZone.addEventListener(
    "drop",
    event => {

        event.preventDefault();

        dropZone.classList.remove(
            "dragover"
        );


        const files =
            event.dataTransfer.files;


        if (
            files.length > 0
        ) {

            processFile(
                files[0]
            );

        }

    }
);


/* ============================================================
   PROCESS FILE
   ============================================================ */

function processFile(file) {

    if (
        !file.name
            .toLowerCase()
            .endsWith(".csv")
    ) {

        alert(
            "Please select a CSV file."
        );

        return;

    }


    const reader =
        new FileReader();


    reader.onload = () => {

        try {

            rawRows =
                parseCSV(
                    reader.result
                );


            if (
                rawRows.length === 0
            ) {

                throw new Error(
                    "The CSV contains no data."
                );

            }


            headers =
                Object.keys(
                    rawRows[0]
                );


            setupColumns();

            detectDates();

            calculate();


            fileStatus.classList.add(
                "visible"
            );


            fileStatus.innerHTML =
                "<strong>" +
                escapeHTML(
                    file.name
                ) +
                "</strong> loaded — " +
                rawRows.length
                    .toLocaleString() +
                " observations.";

        }

        catch (error) {

            alert(
                "Could not process the CSV:\n\n" +
                error.message
            );

        }

    };


    reader.readAsText(file);

}


/* ============================================================
   COLUMN DETECTION
   ============================================================ */

function setupColumns() {

    priceColumn.innerHTML = "";

    dateColumn.innerHTML = "";


    headers.forEach(
        header => {

            const priceOption =
                document.createElement(
                    "option"
                );

            priceOption.value =
                header;

            priceOption.textContent =
                header;

            priceColumn.appendChild(
                priceOption
            );


            const dateOption =
                document.createElement(
                    "option"
                );

            dateOption.value =
                header;

            dateOption.textContent =
                header;

            dateColumn.appendChild(
                dateOption
            );

        }
    );


    const priceGuess =
        findColumn([
            "price",
            "prices",
            "value",
            "lmp",
            "market_price",
            "energy_price"
        ]);


    const dateGuess =
        findColumn([
            "date",
            "datetime",
            "timestamp",
            "time",
            "date_time"
        ]);


    if (
        priceGuess !== null
    ) {

        priceColumn.value =
            priceGuess;

    }


    if (
        dateGuess !== null
    ) {

        dateColumn.value =
            dateGuess;

    }

}


function findColumn(
    possibleNames
) {

    for (
        const header of headers
    ) {

        const normalized =
            header
                .toLowerCase()
                .replace(
                    /[^a-z0-9]/g,
                    ""
                );


        for (
            const name of possibleNames
        ) {

            const target =
                name
                    .toLowerCase()
                    .replace(
                        /[^a-z0-9]/g,
                        ""
                    );


            if (
                normalized === target ||
                normalized.includes(target)
            ) {

                return header;

            }

        }

    }


    return null;

}


/* ============================================================
   DATE PARSING
   ============================================================ */

function parseDate(value) {

    if (!value) {

        return null;

    }


    let date =
        new Date(value);


    if (
        !isNaN(
            date.getTime()
        )
    ) {

        return date;

    }


    const cleaned =
        String(value)
            .trim()
            .replace(
                /\//g,
                "-"
            );


    const parts =
        cleaned.split("-");


    if (
        parts.length === 3
    ) {

        let year =
            Number(parts[0]);

        const month =
            Number(parts[1]);

        const day =
            Number(parts[2]);


        if (year < 100) {

            year += 2000;

        }


        date =
            new Date(
                year,
                month - 1,
                day
            );


        if (
            !isNaN(
                date.getTime()
            )
        ) {

            return date;

        }

    }


    return null;

}


function formatDateInput(date) {

    return [
        date.getFullYear(),
        String(
            date.getMonth() + 1
        ).padStart(2, "0"),
        String(
            date.getDate()
        ).padStart(2, "0")
    ].join("-");

}


/* ============================================================
   DATE RANGE
   ============================================================ */

function detectDates() {

    const column =
        dateColumn.value;


    const dates =
        rawRows
            .map(
                row =>
                    parseDate(
                        row[column]
                    )
            )
            .filter(Boolean)
            .sort(
                (a, b) =>
                    a - b
            );


    if (
        dates.length === 0
    ) {

        return;

    }


    startDate.value =
        formatDateInput(
            dates[0]
        );


    endDate.value =
        formatDateInput(
            dates[dates.length - 1]
        );

}


/* ============================================================
   HOUR EXTRACTION
   ============================================================ */

function extractHour(row) {

    const hourHeader =
        findColumn([
            "hour",
            "hr",
            "hour_of_day"
        ]);


    if (
        hourHeader !== null
    ) {

        const value =
            Number(
                row[hourHeader]
            );


        if (
            Number.isFinite(value) &&
            value >= 0 &&
            value <= 23
        ) {

            return Math.floor(value);

        }

    }


    const date =
        parseDate(
            row[
                dateColumn.value
            ]
        );


    if (!date) {

        return null;

    }


    return date.getHours();

}


/* ============================================================
   STATISTICAL FUNCTIONS
   ============================================================ */

function quantile(
    values,
    q
) {

    if (
        values.length === 0
    ) {

        return null;

    }


    const sorted =
        [...values].sort(
            (a, b) =>
                a - b
        );


    const position =
        (sorted.length - 1) * q;


    const lower =
        Math.floor(position);


    const upper =
        Math.ceil(position);


    if (
        lower === upper
    ) {

        return sorted[lower];

    }


    const weight =
        position - lower;


    return (
        sorted[lower] +
        weight *
        (
            sorted[upper] -
            sorted[lower]
        )
    );

}


function mean(values) {

    if (
        values.length === 0
    ) {

        return null;

    }


    return (
        values.reduce(
            (
                sum,
                value
            ) =>
                sum + value,
            0
        ) /
        values.length
    );

}


/* ============================================================
   MAIN ANALYSIS
   ============================================================ */

function calculate() {

    if (
        rawRows.length === 0
    ) {

        return;

    }


    const start =
        new Date(
            startDate.value +
            "T00:00:00"
        );


    const end =
        new Date(
            endDate.value +
            "T23:59:59.999"
        );


    if (
        isNaN(start.getTime()) ||
        isNaN(end.getTime()) ||
        start > end
    ) {

        return;

    }


    const priceField =
        priceColumn.value;


    const dateField =
        dateColumn.value;


    const hourly =
        Array.from(
            {
                length: 24
            },
            () => []
        );


    for (
        const row of rawRows
    ) {

        const date =
            parseDate(
                row[dateField]
            );


        if (!date) {

            continue;

        }


        if (
            date < start ||
            date > end
        ) {

            continue;

        }


        const price =
            Number(
                String(
                    row[priceField]
                )
                .replace(
                    /[$£€,\s]/g,
                    ""
                )
            );


        if (
            !Number.isFinite(price)
        ) {

            continue;

        }


        const hour =
            extractHour(row);


        if (
            hour === null ||
            hour < 0 ||
            hour > 23
        ) {

            continue;

        }


        hourly[hour].push(
            price
        );

    }


    results =
        hourly.map(
            (
                values,
                hour
            ) => {

                const p10 =
                    quantile(
                        values,
                        0.10
                    );


                const p50 =
                    quantile(
                        values,
                        0.50
                    );


                const p90 =
                    quantile(
                        values,
                        0.90
                    );


                const avg =
                    mean(values);


                return {

                    hour,

                    p10,

                    p50,

                    p90,

                    mean:
                        avg,

                    observations:
                        values.length,

                    spread:
                        p10 !== null &&
                        p90 !== null
                            ? p90 - p10
                            : null

                };

            }
        );


    renderResults();

    drawChart();

    updateDatasetMetrics();

    exportBtn.disabled = false;

}


/* ============================================================
   RESULTS TABLE
   ============================================================ */

function renderResults() {

    resultsBody.innerHTML = "";


    results.forEach(
        row => {

            const tr =
                document.createElement(
                    "tr"
                );


            tr.innerHTML = `

                <td>
                    ${String(
                        row.hour
                    ).padStart(
                        2,
                        "0"
                    )}:00
                </td>

                <td>
                    ${formatNumber(
                        row.p10
                    )}
                </td>

                <td>
                    ${formatNumber(
                        row.p50
                    )}
                </td>

                <td>
                    ${formatNumber(
                        row.p90
                    )}
                </td>

                <td>
                    ${formatNumber(
                        row.mean
                    )}
                </td>

                <td>
                    ${row.observations
                        .toLocaleString()}
                </td>

                <td>
                    ${formatNumber(
                        row.spread
                    )}
                </td>

            `;


            resultsBody.appendChild(
                tr
            );

        }
    );

}


function formatNumber(value) {

    if (
        value === null ||
        value === undefined ||
        !Number.isFinite(value)
    ) {

        return "—";

    }


    return value.toLocaleString(
        undefined,
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

}


/* ============================================================
   DATASET METRICS
   ============================================================ */

function updateDatasetMetrics() {

    if (
        rawRows.length === 0
    ) {

        return;

    }


    const validDates =
        rawRows
            .map(
                row =>
                    parseDate(
                        row[
                            dateColumn.value
                        ]
                    )
            )
            .filter(Boolean);


    const uniqueDays =
        new Set(
            validDates.map(
                date =>
                    formatDateInput(
                        date
                    )
            )
        );


    const representedHours =
        results.length
            ? results.filter(
                row =>
                    row.observations > 0
            ).length
            : 0;


    document.getElementById(
        "metricRows"
    ).textContent =
        rawRows.length
            .toLocaleString();


    document.getElementById(
        "metricDays"
    ).textContent =
        uniqueDays.size
            .toLocaleString();


    document.getElementById(
        "metricHours"
    ).textContent =
        representedHours;


    document.getElementById(
        "metricRange"
    ).textContent =
        startDate.value &&
        endDate.value
            ? `${startDate.value} → ${endDate.value}`
            : "—";


    document.getElementById(
        "datasetDescription"
    ).textContent =
        `${rawRows.length.toLocaleString()} raw observations`;

}


/* ============================================================
   CHART
   ============================================================ */

function resizeCanvas() {

    const rect =
        canvas.getBoundingClientRect();


    const ratio =
        window.devicePixelRatio ||
        1;


    canvas.width =
        rect.width * ratio;


    canvas.height =
        rect.height * ratio;


    ctx.setTransform(
        ratio,
        0,
        0,
        ratio,
        0,
        0
    );

}


function drawChart() {

    resizeCanvas();


    const width =
        canvas.clientWidth;


    const height =
        canvas.clientHeight;


    ctx.clearRect(
        0,
        0,
        width,
        height
    );


    const valid =
        results.filter(
            row =>
                row.p10 !== null ||
                row.p50 !== null ||
                row.p90 !== null ||
                row.mean !== null
        );


    if (
        valid.length === 0
    ) {

        ctx.fillStyle =
            "#9caeb8";

        ctx.font =
            "14px Arial";

        ctx.fillText(
            "No valid observations in this date range.",
            30,
            40
        );

        return;

    }


    const values = [];


    results.forEach(
        row => {

            [
                row.p10,
                row.p50,
                row.p90,
                row.mean
            ].forEach(
                value => {

                    if (
                        value !== null &&
                        Number.isFinite(value)
                    ) {

                        values.push(
                            value
                        );

                    }

                }
            );

        }
    );


    let min =
        Math.min(
            ...values
        );


    let max =
        Math.max(
            ...values
        );


    if (
        min === max
    ) {

        min -= 1;

        max += 1;

    }


    const paddingY =
        (max - min) * 0.08;


    min -= paddingY;

    max += paddingY;


    const margin = {

        left: 75,

        right: 25,

        top: 25,

        bottom: 55

    };


    const chartWidth =
        width -
        margin.left -
        margin.right;


    const chartHeight =
        height -
        margin.top -
        margin.bottom;


    function x(hour) {

        return (
            margin.left +
            (hour / 23) *
            chartWidth
        );

    }


    function y(value) {

        return (
            margin.top +
            (
                1 -
                (
                    value - min
                ) /
                (
                    max - min
                )
            ) *
            chartHeight
        );

    }


    /*
        Horizontal grid.
    */

    ctx.strokeStyle =
        "#294453";

    ctx.lineWidth = 1;


    const gridCount = 6;


    for (
        let i = 0;
        i <= gridCount;
        i++
    ) {

        const value =
            min +
            (
                (max - min) /
                gridCount
            ) *
            i;


        const py =
            y(value);


        ctx.beginPath();

        ctx.moveTo(
            margin.left,
            py
        );

        ctx.lineTo(
            width -
            margin.right,
            py
        );

        ctx.stroke();


        ctx.fillStyle =
            "#7f969f";

        ctx.font =
            "11px Arial";

        ctx.textAlign =
            "right";


        ctx.fillText(
            formatNumber(
                value
            ),
            margin.left - 10,
            py + 4
        );

    }


    /*
        X axis.
    */

    ctx.textAlign =
        "center";

    ctx.fillStyle =
        "#7f969f";

    ctx.font =
        "11px Arial";


    for (
        let hour = 0;
        hour < 24;
        hour++
    ) {

        if (
            hour % 2 === 0
        ) {

            ctx.fillText(
                String(hour)
                    .padStart(
                        2,
                        "0"
                    ),
                x(hour),
                height - 20
            );

        }

    }


    /*
        Draw P10.
    */

    drawSeries(
        results,
        row => row.p10,
        "#e17b73",
        x,
        y
    );


    /*
        Draw P50.
    */

    drawSeries(
        results,
        row => row.p50,
        "#b7d63b",
        x,
        y
    );


    /*
        Draw P90.
    */

    drawSeries(
        results,
        row => row.p90,
        "#6fc4d8",
        x,
        y
    );


    /*
        Draw mean.
    */

    drawSeries(
        results,
        row => row.mean,
        "#f4f3ed",
        x,
        y
    );

}


function drawSeries(
    data,
    getValue,
    color,
    x,
    y
) {

    ctx.strokeStyle =
        color;

    ctx.lineWidth =
        2.2;

    ctx.beginPath();


    let started = false;


    data.forEach(
        row => {

            const value =
                getValue(row);


            if (
                value === null ||
                !Number.isFinite(value)
            ) {

                started = false;

                return;

            }


            const px =
                x(row.hour);


            const py =
                y(value);


            if (!started) {

                ctx.moveTo(
                    px,
                    py
                );

                started = true;

            }

            else {

                ctx.lineTo(
                    px,
                    py
                );

            }

        }
    );


    ctx.stroke();

}


/* ============================================================
   EVENT HANDLERS
   ============================================================ */

startDate.addEventListener(
    "change",
    calculate
);


endDate.addEventListener(
    "change",
    calculate
);


priceColumn.addEventListener(
    "change",
    calculate
);


dateColumn.addEventListener(
    "change",
    () => {

        detectDates();

        calculate();

    }
);


window.addEventListener(
    "resize",
    () => {

        if (
            results.length > 0
        ) {

            drawChart();

        }

    }
);


/* ============================================================
   EXPORT
   ============================================================ */

exportBtn.addEventListener(
    "click",
    exportResults
);


function exportResults() {

    if (
        results.length === 0
    ) {

        return;

    }


    const header = [

        "hour",
        "P10",
        "P50",
        "P90",
        "mean",
        "observations",
        "P90_minus_P10"

    ];


    const lines = [
        header.join(",")
    ];


    results.forEach(
        row => {

            lines.push([

                row.hour,

                row.p10 ?? "",

                row.p50 ?? "",

                row.p90 ?? "",

                row.mean ?? "",

                row.observations,

                row.spread ?? ""

            ].join(","));

        }
    );


    const blob =
        new Blob(
            [
                lines.join("\n")
            ],
            {
                type:
                    "text/csv;charset=utf-8;"
            }
        );


    const url =
        URL.createObjectURL(
            blob
        );


    const link =
        document.createElement(
            "a"
        );


    link.href = url;


    link.download =
        "hourly_price_statistics.csv";


    link.click();


    URL.revokeObjectURL(
        url
    );

}


/* ============================================================
   DEMO DATA
   ============================================================ */

demoBtn.addEventListener(
    "click",
    loadDemoData
);


function loadDemoData() {

    const rows = [];


    const start =
        new Date(
            "2026-01-01T00:00:00"
        );


    const days = 120;


    for (
        let day = 0;
        day < days;
        day++
    ) {

        for (
            let hour = 0;
            hour < 24;
            hour++
        ) {

            const date =
                new Date(start);


            date.setDate(
                date.getDate() +
                day
            );


            date.setHours(
                hour,
                0,
                0,
                0
            );


            let base;


            /*
                Representative intraday shape.
            */

            if (
                hour <= 5
            ) {

                base =
                    110 +
                    hour * 3;

            }

            else if (
                hour <= 9
            ) {

                base =
                    120 +
                    (
                        hour - 5
                    ) * 8;

            }

            else if (
                hour <= 15
            ) {

                base =
                    75 -
                    (
                        hour - 10
                    ) * 7;

            }

            else if (
                hour <= 18
            ) {

                base =
                    55 +
                    (
                        hour - 15
                    ) * 28;

            }

            else if (
                hour <= 21
            ) {

                base =
                    135 +
                    (
                        hour - 18
                    ) * 20;

            }

            else {

                base =
                    170 -
                    (
                        hour - 21
                    ) * 15;

            }


            /*
                Daily volatility.
            */

            const dailyShock =
                Math.sin(
                    day * 0.43
                ) * 25 +
                Math.sin(
                    day * 0.17
                ) * 15;


            /*
                Occasional high-price event.
            */

            let scarcity = 0;


            if (
                day % 17 === 0 &&
                hour >= 18 &&
                hour <= 22
            ) {

                scarcity =
                    120 +
                    Math.random() *
                    150;

            }


            /*
                Occasional low-price event.
            */

            let lowEvent = 0;


            if (
                day % 13 === 0 &&
                hour >= 10 &&
                hour <= 15
            ) {

                lowEvent =
                    -50 -
                    Math.random() *
                    30;

            }


            const noise =
                (
                    Math.random() -
                    0.5
                ) * 30;


            const price =
                Math.max(
                    -100,
                    base +
                    dailyShock +
                    scarcity +
                    lowEvent +
                    noise
                );


            rows.push({

                Date:
                    formatDateTime(
                        date
                    ),

                Hour:
                    hour,

                Price:
                    price.toFixed(2)

            });

        }

    }


    rawRows = rows;


    headers = [
        "Date",
        "Hour",
        "Price"
    ];


    setupColumns();


    dateColumn.value =
        "Date";


    priceColumn.value =
        "Price";


    detectDates();


    calculate();


    fileStatus.classList.add(
        "visible"
    );


    fileStatus.innerHTML =
        "<strong>Demo dataset</strong> loaded — " +
        rawRows.length
            .toLocaleString() +
        " observations.";

}


function formatDateTime(date) {

    const year =
        date.getFullYear();


    const month =
        String(
            date.getMonth() + 1
        ).padStart(
            2,
            "0"
        );


    const day =
        String(
            date.getDate()
        ).padStart(
            2,
            "0"
        );


    const hour =
        String(
            date.getHours()
        ).padStart(
            2,
            "0"
        );


    return (
        `${year}-${month}-${day} ${hour}:00`
    );

}


/* ============================================================
   HTML ESCAPING
   ============================================================ */

function escapeHTML(value) {

    return String(value)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );

}


/* ============================================================
   INITIALISE
   ============================================================ */

loadDemoData();

