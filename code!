<script>

/* ============================================================
   GLOBAL STATE
   ============================================================ */

let rawRows = [];

let headers = [];

let results = [];


/* ============================================================
   DOM REFERENCES
   ============================================================ */

const fileInput =
    document.getElementById(
        "fileInput"
    );

const fileButton =
    document.getElementById(
        "fileButton"
    );

const dropZone =
